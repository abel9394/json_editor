/* Dark scientific theme for the JSON device editor */

QMainWindow, QWidget {
    background-color: #121820;
    color: #e8eef4;
    font-family: "Microsoft YaHei UI", "Segoe UI", sans-serif;
    font-size: 13px;
}

QWidget#AppRoot {
    background-color: #121820;
}

QWidget#TopBar {
    background-color: #171e28;
    border-bottom: 1px solid #2d3a4d;
}

QLabel#AppTitle {
    color: #e8eef4;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.3px;
}

QLabel#FileLabel {
    color: #8b9cb3;
    font-size: 12px;
}

QLabel#DirtyDot {
    color: #f0b429;
    font-size: 16px;
    font-weight: 700;
}

QPushButton {
    background-color: #243044;
    color: #e8eef4;
    border: 1px solid #33455c;
    border-radius: 8px;
    padding: 6px 14px;
    min-height: 28px;
}

QPushButton:hover {
    background-color: #2c3b52;
    border-color: #3d9cf0;
}

QPushButton:pressed {
    background-color: #1e5a8c;
}

QPushButton:disabled {
    color: #5c6d82;
    background-color: #1a2332;
    border-color: #2d3a4d;
}

QPushButton#PrimaryButton {
    background-color: #1e5a8c;
    border-color: #3d9cf0;
    color: #ffffff;
    font-weight: 600;
}

QPushButton#PrimaryButton:hover {
    background-color: #2870ad;
}

QPushButton#PrimaryButton:disabled {
    background-color: #1a2332;
    border-color: #2d3a4d;
    color: #5c6d82;
}

QFrame#Sidebar,
QFrame#DetailPanel {
    background-color: #171e28;
    border: 1px solid #2d3a4d;
    border-radius: 12px;
}

QLineEdit, QPlainTextEdit {
    background-color: #1a2332;
    color: #e8eef4;
    border: 1px solid #2d3a4d;
    border-radius: 8px;
    padding: 6px 10px;
    selection-background-color: #1e5a8c;
}

QLineEdit:focus {
    border: 1px solid #3d9cf0;
}

QLineEdit#SearchBox {
    padding-left: 12px;
    min-height: 32px;
}

QTreeWidget {
    background-color: #151c26;
    alternate-background-color: #1a2332;
    color: #e8eef4;
    border: none;
    border-radius: 8px;
    outline: none;
    padding: 4px;
}

QTreeWidget::item {
    min-height: 26px;
    padding: 2px 6px;
    border-radius: 6px;
}

QTreeWidget::item:hover {
    background-color: #243044;
}

QTreeWidget::item:selected {
    background-color: #1e5a8c;
    color: #ffffff;
}

QTreeWidget::branch {
    background: transparent;
}

QHeaderView::section {
    background-color: #1a2332;
    color: #8b9cb3;
    border: none;
    border-bottom: 1px solid #2d3a4d;
    padding: 8px 10px;
    font-weight: 600;
}

QSplitter::handle {
    background-color: #121820;
    width: 8px;
}

QStatusBar {
    background-color: #171e28;
    color: #8b9cb3;
    border-top: 1px solid #2d3a4d;
}

QStatusBar::item {
    border: none;
}

QMenu {
    background-color: #1a2332;
    color: #e8eef4;
    border: 1px solid #2d3a4d;
    border-radius: 8px;
    padding: 6px;
}

QMenu::item {
    padding: 6px 18px;
    border-radius: 6px;
}

QMenu::item:selected {
    background-color: #1e5a8c;
}

QMenu::separator {
    height: 1px;
    background: #2d3a4d;
    margin: 4px 8px;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 4px 2px;
}

QScrollBar::handle:vertical {
    background: #33455c;
    border-radius: 5px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #3d9cf0;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
    height: 0;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px 4px;
}

QScrollBar::handle:horizontal {
    background: #33455c;
    border-radius: 5px;
    min-width: 24px;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: none;
    width: 0;
}

QToolTip {
    background-color: #243044;
    color: #e8eef4;
    border: 1px solid #3d9cf0;
    padding: 6px 8px;
    border-radius: 6px;
}

QLabel#TypeBadge {
    color: #121820;
    font-size: 11px;
    font-weight: 700;
    padding: 2px 10px;
    border-radius: 9px;
}

QLabel#DeviceName {
    font-size: 20px;
    font-weight: 700;
    color: #ffffff;
}

QLabel#DeviceMeta {
    color: #8b9cb3;
    font-size: 12px;
}

QLabel#EmptyHint {
    color: #6b7c91;
    font-size: 14px;
}

QFrame#HeaderCard {
    background-color: #1a2332;
    border: 1px solid #2d3a4d;
    border-radius: 10px;
}

QFrame#RangePanel {
    background-color: #171e28;
    border: 1px solid #2d3a4d;
    border-radius: 12px;
}

QSpinBox, QComboBox {
    background-color: #1a2332;
    color: #e8eef4;
    border: 1px solid #2d3a4d;
    border-radius: 8px;
    padding: 4px 8px;
    min-height: 26px;
}

QSpinBox:focus, QComboBox:focus {
    border: 1px solid #3d9cf0;
}

QComboBox::drop-down {
    border: none;
    width: 18px;
}

QComboBox QAbstractItemView {
    background-color: #1a2332;
    color: #e8eef4;
    selection-background-color: #1e5a8c;
    border: 1px solid #2d3a4d;
}

QListWidget#RangeList {
    background-color: #151c26;
    color: #e8eef4;
    border: 1px solid #2d3a4d;
    border-radius: 8px;
    outline: none;
    padding: 4px;
}

QListWidget#RangeList::item {
    min-height: 22px;
    padding: 2px 6px;
    border-radius: 4px;
}

QListWidget#RangeList::item:selected {
    background-color: #1e5a8c;
    color: #ffffff;
}

QListWidget#RangeList::item:hover {
    background-color: #243044;
}
